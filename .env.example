NEXT_PUBLIC_V0_URL=https://v0.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Serve under a sub-path instead of the root, e.g. "/ui" (default: root).
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_ASSET_PREFIX=

# ─── S3 / R2 connection (optional) ───────────────────────────────────────────
# Provider: s3 | r2 | s3-compatible  (default: s3)
# NEXT_PUBLIC_S3_PROVIDER=s3
# NEXT_PUBLIC_S3_NAME=My bucket          # sidebar label (defaults to bucket)
# NEXT_PUBLIC_S3_BUCKET=my-bucket
# NEXT_PUBLIC_S3_ACCESS_KEY_ID=
# NEXT_PUBLIC_S3_SECRET_ACCESS_KEY=

# AWS S3:
# NEXT_PUBLIC_S3_REGION=us-east-1

# Cloudflare R2 (set PROVIDER=r2):
# NEXT_PUBLIC_R2_ACCOUNT_ID=

# S3-compatible (set PROVIDER=s3-compatible — MinIO, Wasabi, Backblaze, Spaces):
# NEXT_PUBLIC_S3_ENDPOINT=https://s3.us-west-1.wasabisys.com
# NEXT_PUBLIC_S3_FORCE_PATH_STYLE=false  # set true for MinIO

# Optional CDN/public origin — when set, file URLs skip signing:
# NEXT_PUBLIC_S3_PUBLIC_BASE_URL=
