NEXT_PUBLIC_APP_URL=http://localhost:3000

# Serve under a sub-path instead of the root, e.g. "/ui" (default: root).
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_ASSET_PREFIX=

# ─── Login (optional) ────────────────────────────────────────────────────────
# Set both to require a username + password before the app can be used. Leave
# either blank to keep the app open. AUTH_SECRET is optional — it signs the
# session cookie; if omitted the credentials are used, so changing the password
# signs everyone out.
# AUTH_USERNAME=
# AUTH_PASSWORD=
# AUTH_SECRET=

# ─── Buckets (optional, server-only) ─────────────────────────────────────────
# Add buckets by numbering them BUCKET_1_*, BUCKET_2_*, … A slot loads only when
# BUCKET / ACCESS_KEY_ID / SECRET_ACCESS_KEY are set. Optional: NAME, REGION,
# ACCOUNT_ID (R2), ENDPOINT + FORCE_PATH_STYLE, PUBLIC_BASE_URL, READ_ONLY.

# BUCKET_1_PROVIDER=s3            # s3 | r2 | alibaba | backblaze-b2 | minio | s3-compatible (default: s3)
# BUCKET_1_NAME=Production
# BUCKET_1_BUCKET=my-bucket
# BUCKET_1_REGION=us-east-1
# BUCKET_1_ACCESS_KEY_ID=
# BUCKET_1_SECRET_ACCESS_KEY=
# BUCKET_1_READ_ONLY=true          # Optional: disable every mutating operation

# Provider-specific extras:
#   R2             BUCKET_2_PROVIDER=r2             + BUCKET_2_ACCOUNT_ID=…
#   Alibaba OSS    BUCKET_3_PROVIDER=alibaba        + BUCKET_3_REGION=cn-hangzhou
#   Backblaze B2   BUCKET_4_PROVIDER=backblaze-b2   + BUCKET_4_REGION=us-west-002
#   MinIO          BUCKET_5_PROVIDER=minio          + BUCKET_5_ENDPOINT=http://localhost:9000
#   S3-compatible  BUCKET_6_PROVIDER=s3-compatible  + BUCKET_6_ENDPOINT=https://…
